# Environment variables for the data platform demo.
# This file is gitignored — fill in real values; never commit secrets.
#
# Load into your shell before running schemachange / dbt / the Airflow script:
#   source .env
# ============================================================================

# --- AWS / CDK --------------------------------------------------------------
# AWS_PROFILE selects credentials from ~/.aws/ (run `aws configure --profile <name>`).
# CDK_DEFAULT_ACCOUNT/REGION target the deployment; required (no defaults in code).
export AWS_PROFILE=your-aws-profile
export AWS_DEFAULT_REGION=us-east-2
export AWS_REGION=us-east-2
export CDK_DEFAULT_ACCOUNT=000000000000
export CDK_DEFAULT_REGION=us-east-2

# --- Snowflake: shared ------------------------------------------------------
# Account identifier, e.g. abc-xy123 (the part before .snowflakecomputing.com).
export SNOWFLAKE_ACCOUNT=

# --- Snowflake: schemachange (runs as SCHEMACHANGE_USER) --------------------
export SNOWFLAKE_USER=SCHEMACHANGE_USER
export SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/schemachange_key.p8
export SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Snowflake: dbt (runs as DBT_USER) --------------------------------------
export DBT_SNOWFLAKE_USER=DBT_USER
export DBT_PRIVATE_KEY_PATH=/absolute/path/to/dbt_key.p8
export DBT_PRIVATE_KEY_PASSPHRASE=

# --- Local Airflow (scripts/run_airflow_local.sh) ---------------------------
# NOTE: the script also reads SNOWFLAKE_USER (set above to SCHEMACHANGE_USER).
# When running local Airflow as dbt, override it: SNOWFLAKE_USER=DBT_USER.
export SNOWFLAKE_PASSWORD=
export SNOWFLAKE_WAREHOUSE=DBT_WH
export SNOWFLAKE_DATABASE=GOLD
export SNOWFLAKE_ROLE=DBT_ROLE
# Fixed admin login for the standalone Airflow UI (http://localhost:8080).
export AIRFLOW_ADMIN_PASSWORD=admin

# --- Snowflake: Cortex Analyst (runs as CORTEX_USER) -------------------------
# Key pair is generated at .secrets/cortex_key.p8 / .secrets/cortex_key.pub
# by running:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out .secrets/cortex_key.p8 -nocrypt
#   openssl rsa -in .secrets/cortex_key.p8 -pubout -out .secrets/cortex_key.pub
# The public key is embedded in V1.1.8__cortex_analyst_setup.sql (schemachange).
# The private key is loaded into Secrets Manager automatically by app.py at cdk synth time.
# (No additional env vars needed — app.py reads .secrets/cortex_key.p8 directly.)

# --- Deployed API endpoints (output by `cdk deploy`) -------------------------
# Copy the EventsEndpoint and AskEndpoint from the CDK stack outputs.
export EVENTS_API_URL=https://your-api-id.execute-api.us-east-2.amazonaws.com/prod/events
export ANALYST_API_URL=https://your-api-id.execute-api.us-east-2.amazonaws.com/prod/ask

# --- CDK context (reference only — NOT read as env vars) --------------------
# Pass these to CDK with `-c key=value` or edit infra/cdk.json:
#   -c prefix=dataplatform
#   -c demo_token=demo-allow-token
#   -c snowflake_database=BRONZE -c snowflake_schema=RAW -c snowflake_table=EVENTS
# Note: snowflake_account_url is derived automatically from SNOWFLAKE_ACCOUNT above.
